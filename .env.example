# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=erman_ai
POSTGRES_USER=erman_ai
POSTGRES_PASSWORD=change_me_postgres

# MySQL (WordPress)
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=change_me_wp
WP_DB_ROOT_PASSWORD=change_me_wp_root

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_FAST=google/gemini-flash-1.5-8b
OPENROUTER_MODEL_SMART=anthropic/claude-sonnet-4-5
OPENROUTER_MODEL_EMBED=openai/text-embedding-3-small

# Backend
SERVER_PORT=8080
JWT_SECRET=change_me_jwt_secret_min_32_chars
API_KEY_SALT=change_me_api_key_salt
ENVIRONMENT=development
LOG_LEVEL=info
# Optional: path to Chrome/Chromium for PDF export (auto-detected if unset)
# CHROME_PATH=/usr/bin/chromium
AUTOMATION_SAVINGS_RATE=0.7

# Database URL (used by goose and backend)
DATABASE_URL=postgres://erman_ai:change_me_postgres@postgres:5432/erman_ai?sslmode=disable

# Frontend
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME="Erman AI"

# Workers
WORKER_STRATEGY_CONCURRENCY=3
WORKER_PROPOSAL_CONCURRENCY=3

# Storage (production)
STORAGE_BACKEND=local
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=erman-ai-artifacts

# Production services (commented in dev)
# NATS_URL=nats://nats:4222
# DRAGONFLY_URL=redis://dragonfly:6379

# Domain & SSL
DOMAIN=erman.ai
CERTBOT_EMAIL=hello@erman.ai
