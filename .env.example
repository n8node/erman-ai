# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=erman_ai
POSTGRES_USER=erman_ai
POSTGRES_PASSWORD=change_me_postgres

# MySQL (WordPress)
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=change_me_wp
WP_DB_ROOT_PASSWORD=change_me_wp_root

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_FAST=google/gemini-flash-1.5-8b
OPENROUTER_MODEL_SMART=anthropic/claude-sonnet-4-5
OPENROUTER_MODEL_EMBED=openai/text-embedding-3-small

# DeepSeek (direct API for strategy A/B testing)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_DEFAULT=deepseek-chat

# Yandex GPT (Yandex AI Studio)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1
YANDEX_MODEL_SMART=yandexgpt/latest
YANDEX_MODEL_FAST=yandexgpt-lite/latest
YANDEX_PRICE_INPUT_RUB_PER_1K=0.6
YANDEX_PRICE_OUTPUT_RUB_PER_1K=1.8

# LLM token pricing fallbacks (USD per 1K tokens, used until admin overrides)
OPENROUTER_PRICE_INPUT_USD_PER_1K=0.003
OPENROUTER_PRICE_OUTPUT_USD_PER_1K=0.015
DEEPSEEK_PRICE_INPUT_USD_PER_1K=0.014
DEEPSEEK_PRICE_OUTPUT_USD_PER_1K=0.028

# Backend
SERVER_PORT=8080
JWT_SECRET=change_me_jwt_secret_min_32_chars
API_KEY_SALT=change_me_api_key_salt
ENVIRONMENT=development
LOG_LEVEL=info
# Optional: path to Chrome/Chromium for PDF export (auto-detected if unset)
# CHROME_PATH=/usr/bin/chromium
AUTOMATION_SAVINGS_RATE=0.7

# Database URL (used by goose and backend)
DATABASE_URL=postgres://erman_ai:change_me_postgres@postgres:5432/erman_ai?sslmode=disable

# Frontend
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME="Erman AI"

# Workers
WORKER_STRATEGY_CONCURRENCY=3
WORKER_PROPOSAL_CONCURRENCY=3

# Storage (production)
STORAGE_BACKEND=local
TELEGRAM_ASSETS_DIR=/app/data/telegram
GEOLOGICAL_JOURNAL_ASSETS_DIR=/app/data/geological-journal
AUDIO_TRANSCRIPTION_ASSETS_DIR=/app/data/audio-transcription
VIDEO_TRANSCRIPTION_ASSETS_DIR=/app/data/video-transcription
# Internal OpenCV service. Leave empty when running backend outside Docker.
JOURNAL_PREPROCESSOR_URL=http://journal-preprocessor:8090
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=erman-ai-artifacts

# Production services (commented in dev)
# NATS_URL=nats://nats:4222
# DRAGONFLY_URL=redis://dragonfly:6379

# AFFiNE Workspace (disabled by default — start with: docker compose --profile affine up -d)
# AFFINE_REVISION=stable
# AFFINE_DB_USER=affine
# AFFINE_DB_PASSWORD=change_me_affine_postgres
# AFFINE_DB_NAME=affine
# AFFINE_SERVER_EXTERNAL_URL=http://localhost/workspace-app

# Erman AI OIDC for AFFiNE (only needed when AFFiNE profile is enabled)
# WORKSPACE_OIDC_CLIENT_ID=erman-affine
# WORKSPACE_OIDC_CLIENT_SECRET=change_me_workspace_oidc_secret
# WORKSPACE_OIDC_PRIVATE_KEY_B64=
# WORKSPACE_OIDC_REDIRECT_URI=http://localhost/oauth/callback

# Domain & SSL
DOMAIN=erman.ai
CERTBOT_EMAIL=hello@erman.ai
