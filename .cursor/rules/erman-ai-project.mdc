## База данных — ключевые таблицы

```sql
-- Пользователи
users (id, email, password_hash, role, plan_id, created_at, last_active_at, is_blocked)

-- API ключи
api_keys (id, user_id, key_hash, name, last_used_at, created_at, revoked_at)

-- Тарифные планы
plans (id, slug, name, price_monthly_rub, price_yearly_rub, tool_limits jsonb,
       features jsonb, support_level, is_public, is_archived)

-- История платежей
subscriptions (id, user_id, plan_id, started_at, expires_at, amount_rub, status)

-- Запуски инструментов
tool_runs (id, user_id, tool_slug, plan_tier, input jsonb, output jsonb,
           artifact_url, tokens_used, model_used, status, error_msg,
           created_at, updated_at, completed_at)

-- LLM usage log
usage_log (id, user_id, run_id, model, prompt_tokens, completion_tokens,
           total_tokens, cost_usd, created_at)

-- Счётчик запусков (для лимитов)
tool_usage_counters (user_id, tool_slug, period_month, runs_count,
                     PRIMARY KEY (user_id, tool_slug, period_month))
```

