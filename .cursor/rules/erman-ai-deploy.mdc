## Makefile

```makefile
.PHONY: dev prod down migrate migrate-down test lint logs logs-prod \
        psql wp-cli deploy backup-db backup-wp status ssl-renew

# Development
dev:
	docker compose up --build

prod:
	docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d

down:
	docker compose down

# Migrations
migrate:
	docker compose exec backend goose -dir ./migrations postgres "$$DATABASE_URL" up

migrate-down:
	docker compose exec backend goose -dir ./migrations postgres "$$DATABASE_URL" down

# Testing
test:
	cd backend && go test ./...

lint:
	cd backend && golangci-lint run
	cd frontend && npm run lint

# Logs
logs:
	docker compose logs -f

logs-prod:
	docker compose -f docker-compose.yml -f docker-compose.prod.yml logs -f

# DB access
psql:
	docker compose exec postgres psql -U erman_ai erman_ai

# WordPress CLI
wp-cli:
	docker compose exec wordpress wp --allow-root $(filter-out $@,$(MAKECMDGOALS))

# Deploy
deploy:
	./scripts/deploy.sh main

deploy-dev:
	./scripts/deploy.sh develop

# SSL
ssl-renew:
	docker compose -f docker-compose.yml -f docker-compose.prod.yml exec nginx \
	  certbot renew
	docker compose -f docker-compose.yml -f docker-compose.prod.yml exec nginx \
	  nginx -s reload

# Backups
backup-db:
	docker compose exec postgres pg_dump -U erman_ai erman_ai \
	  | gzip > backups/pg_$(shell date +%Y%m%d_%H%M%S).sql.gz

backup-wp:
	docker compose exec mysql mysqldump -u wordpress -p wordpress \
	  | gzip > backups/wp_$(shell date +%Y%m%d_%H%M%S).sql.gz

# Status
status:
	docker compose -f docker-compose.yml -f docker-compose.prod.yml ps
```

